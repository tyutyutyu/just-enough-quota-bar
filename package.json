{
  "name": "just-enough-quota-bar",
  "displayName": "Just Enough Quota Bar",
  "description": "Claude Code and Codex subscription quota windows in the VS Code status bar. Nothing more.",
  "version": "0.0.1",
  "publisher": "tyutyutyu",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/tyutyutyu/just-enough-quota-bar.git"
  },
  "bugs": {
    "url": "https://github.com/tyutyutyu/just-enough-quota-bar/issues"
  },
  "homepage": "https://github.com/tyutyutyu/just-enough-quota-bar#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "quota",
    "status bar"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jeqb.refresh",
        "title": "Refresh quota",
        "category": "Just Enough Quota Bar"
      }
    ],
    "configuration": {
      "title": "Just Enough Quota Bar",
      "properties": {
        "jeqb.thresholds": {
          "type": "object",
          "default": {
            "5h.pct": [
              {
                "gte": 70,
                "color": "charts.yellow"
              },
              {
                "gte": 90,
                "color": "errorForeground",
                "background": "error"
              }
            ],
            "week.pct": [
              {
                "gte": 70,
                "color": "charts.yellow"
              },
              {
                "gte": 90,
                "color": "errorForeground"
              }
            ],
            "banked.expires": [
              {
                "lte": "3d",
                "color": "charts.orange"
              },
              {
                "lte": "1d",
                "color": "errorForeground"
              }
            ]
          },
          "markdownDescription": "Colors by variable name. Each value is a list of steps evaluated in order; the last matching step wins. Time variables compare the remaining duration.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "gte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than or equal to this number or duration such as \"3d\"."
                },
                "gt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than this number or duration."
                },
                "lte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than or equal to this number or duration such as \"90m\"."
                },
                "lt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than this number or duration."
                },
                "eq": {
                  "type": "string",
                  "description": "Matches when a text variable equals this text."
                },
                "color": {
                  "type": "string",
                  "description": "Theme color ID such as charts.red, or #rrggbb."
                },
                "background": {
                  "type": "string",
                  "enum": [
                    "warning",
                    "error"
                  ],
                  "description": "Status bar background; VS Code only allows warning and error."
                }
              }
            }
          }
        },
        "jeqb.claude.thresholds": {
          "type": "object",
          "default": {},
          "markdownDescription": "Claude thresholds; each key replaces the same key of `#jeqb.thresholds#`.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "gte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than or equal to this number or duration such as \"3d\"."
                },
                "gt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than this number or duration."
                },
                "lte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than or equal to this number or duration such as \"90m\"."
                },
                "lt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than this number or duration."
                },
                "eq": {
                  "type": "string",
                  "description": "Matches when a text variable equals this text."
                },
                "color": {
                  "type": "string",
                  "description": "Theme color ID such as charts.red, or #rrggbb."
                },
                "background": {
                  "type": "string",
                  "enum": [
                    "warning",
                    "error"
                  ],
                  "description": "Status bar background; VS Code only allows warning and error."
                }
              }
            }
          }
        },
        "jeqb.codex.thresholds": {
          "type": "object",
          "default": {},
          "markdownDescription": "Codex thresholds; each key replaces the same key of `#jeqb.thresholds#`.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "gte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than or equal to this number or duration such as \"3d\"."
                },
                "gt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is greater than this number or duration."
                },
                "lte": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than or equal to this number or duration such as \"90m\"."
                },
                "lt": {
                  "type": [
                    "number",
                    "string"
                  ],
                  "description": "Matches when the value is less than this number or duration."
                },
                "eq": {
                  "type": "string",
                  "description": "Matches when a text variable equals this text."
                },
                "color": {
                  "type": "string",
                  "description": "Theme color ID such as charts.red, or #rrggbb."
                },
                "background": {
                  "type": "string",
                  "enum": [
                    "warning",
                    "error"
                  ],
                  "description": "Status bar background; VS Code only allows warning and error."
                }
              }
            }
          }
        },
        "jeqb.staleColor": {
          "type": "string",
          "default": "disabledForeground",
          "markdownDescription": "Color of stale data, above every threshold. Theme color ID or `#rrggbb`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "build": "node esbuild.mjs",
    "build:production": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "compile:test": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile:test && node out/test/integration/runTest.js",
    "package": "vsce package --no-dependencies --out just-enough-quota-bar.vsix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "mocha": "12.0.3",
    "ovsx": "1.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
